# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...

# Port the server listens on (default 8787).
PORT=8787

# Which LLM backend to use: "anthropic" (prod) or "ollama" (dev/test via Ollama Cloud).
LLM_PROVIDER=anthropic

# Supabase Postgres — use the TRANSACTION POOLER connection string (port 6543).
# Supabase dashboard → Connect → Transaction pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# The WEB OAuth client ID from Google Cloud Console (audience for ID-token verification).
# Must match BuildConfig.GOOGLE_WEB_CLIENT_ID in the Android app.
GOOGLE_WEB_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com

# All accepted ID-token audiences, comma-separated (web + desktop clients). Optional —
# falls back to GOOGLE_WEB_CLIENT_ID alone if unset.
GOOGLE_CLIENT_IDS=1234567890-web.apps.googleusercontent.com,1234567890-desktop.apps.googleusercontent.com

# Desktop-app OAuth client (Mac/PC loopback sign-in via POST /v1/auth/google/desktop).
# The "secret" of a Desktop-app client is not confidential in the OAuth sense, but Google
# still requires it at code exchange — keeping it here means it never ships in a binary.
GOOGLE_DESKTOP_CLIENT_ID=1234567890-desktop.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=GOCSPX-...

# Free-tier cap: drafts per user per UTC day (default 50).
FREE_DAILY_LIMIT=50

# Comma-separated Google account emails with unlimited everything — drafts and cloud STT
# (devs/testers). Usage still counted, never blocked.
FREE_LIMIT_EXEMPT_EMAILS=you@gmail.com

# Cloud STT for /v1/stt/stream (VOICE_PLAN V3): "deepgram" (prod) or "mock" (dev/test, no key or
# network needed — emits fake transcripts so clients can be built before a Deepgram account exists).
# Beta entitlement: free desktop accounts get FREE_STT_DAILY_LIMIT sessions/day; pro is unlimited
# sessions; free Android is denied (it has the on-device engine).
STT_PROVIDER=deepgram

# Free-tier cap: cloud dictation sessions per desktop user per UTC day (default 50).
FREE_STT_DAILY_LIMIT=50

# Daily ceiling on proxied STT audio per user, in seconds (default 1800 = 30 min).
# Bounds Deepgram spend; exempt emails bypass it (usage still metered).
STT_DAILY_SECONDS=1800
# https://console.deepgram.com — a zero-retention agreement is a launch gate (see PRIVACY.md).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Ollama Cloud settings (used only when LLM_PROVIDER=ollama).
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_API_KEY=              # create at https://ollama.com/settings/keys
OLLAMA_MODEL_PERSONAL=gpt-oss:120b
OLLAMA_MODEL_PROFESSIONAL=gpt-oss:120b
