{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReplyMint",
  "version": "0.1.0",
  "identifier": "com.replymint.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "settings",
        "title": "ReplyMint",
        "width": 440,
        "height": 720,
        "resizable": false,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "ReplyMint Overlay",
        "url": "overlay.html",
        "width": 600,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
