<?xml version="1.0" encoding="utf-8"?>
<!-- A real filled button. The old bg_menu_button was a ripple over a transparent shape, so the
     Stop control had no resting appearance and looked like unstyled text until pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/mint" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
</ripple>
