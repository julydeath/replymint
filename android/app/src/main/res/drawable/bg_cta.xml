<?xml version="1.0" encoding="utf-8"?>
<!-- Filled mint CTA with a light→deep gradient (voice "Stop & use", plain-View buttons). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="@color/brand"
                android:startColor="@color/cta_hi" />
            <corners android:radius="@dimen/row_radius" />
        </shape>
    </item>
</ripple>
