<?xml version="1.0" encoding="utf-8"?>
<!-- White disc behind the brand mark (the bubble is the white round logo). The hairline
     stroke separates it from light app backgrounds; elevation handles dark ones. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="#FFFFFF" />
    <stroke android:width="1dp" android:color="#1F000000" />
</shape>
