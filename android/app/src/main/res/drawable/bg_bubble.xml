<?xml version="1.0" encoding="utf-8"?>
<!-- The mint orb: radial gradient with an off-centre highlight so it reads as a lit sphere,
     not a flat disc. The rim light separates it from a dark chat background. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <gradient
        android:centerColor="@color/mint"
        android:centerX="0.34"
        android:centerY="0.3"
        android:endColor="@color/brand_dark"
        android:gradientRadius="46dp"
        android:startColor="#7CF5C8"
        android:type="radial" />
    <stroke android:width="1dp" android:color="#8CFFFFFF" />
</shape>
