    <string name="onb_how_title">How it works</string>
    <string name="onb_how_1_title">The bubble appears</string>
    <string name="onb_how_1_sub">Only in your chat apps, only on screens with a reply box.</string>
    <string name="onb_how_2_title">Tap an action</string>
    <string name="onb_how_2_sub">Auto Reply drafts for you. Voice types what you say. Fix polishes what you typed.</string>
    <string name="onb_how_3_title">The draft lands in the box</string>
    <string name="onb_how_3_sub">Nothing is ever sent for you — you always review and hit send yourself.</string>
    <string name="onb_apps_title">Works right inside</string>
