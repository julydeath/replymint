    <string name="app_name">ReplyMint</string>
    <string name="accessibility_label">ReplyMint</string>
    <string name="accessibility_description">ReplyMint reads the visible conversation ONLY when you tap the bubble, and writes a draft into the reply box. It never sends anything. In the background it only checks whether a text box is on screen (to show its bubble there) — it never reads your conversation unless you tap.</string>

    <string name="tagline">One best reply, right inside any app.</string>
    <string name="mode_personal">Personal</string>
    <string name="mode_professional">Professional</string>

