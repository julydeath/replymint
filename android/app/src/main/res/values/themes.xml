<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ReplyMint" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/on_brand</item>
    </style>

    <!-- Used only via ContextThemeWrapper when inflating overlays. The accessibility service
         context carries no app theme, so anything resolving ?attr/ would fail against it. -->
    <style name="Theme.ReplyMint.Overlay" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/mint</item>
        <item name="colorOnPrimary">@color/on_mint</item>
        <item name="colorSurface">@color/glass_surface</item>
    </style>
</resources>
