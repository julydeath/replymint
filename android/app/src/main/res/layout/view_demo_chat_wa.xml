<?xml version="1.0" encoding="utf-8"?>
<!-- Tour-demo prop only: a miniature stand-in for a WhatsApp chat so the tour can show the
     bubble in context. Never shown outside onboarding. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/skin_wa"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2C34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_demo_av_wa"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:text="P"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/demo_wa_name"
                android:textColor="#E9EDEF"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/demo_wa_presence"
                android:textColor="#8696A0"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="9dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_demo_msg_wa"
            android:maxWidth="165dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:text="@string/demo_wa_in1"
            android:textColor="#E9EDEF"
            android:textSize="10.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_demo_msg_wa"
            android:maxWidth="165dp"
            android:paddingHorizontal="9dp"
            android:paddingVertical="6dp"
            android:text="@string/demo_wa_in2"
            android:textColor="#E9EDEF"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="7dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_demo_composer_wa"
            android:minHeight="32dp"
            android:paddingHorizontal="11dp"
            android:paddingVertical="7dp">

            <TextView
                android:id="@+id/demo_composer_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:hint="@string/demo_hint_message"
                android:maxLines="3"
                android:textColor="#E9EDEF"
                android:textColorHint="#8696A0"
                android:textSize="10.5sp" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_demo_fab_wa">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_send" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
