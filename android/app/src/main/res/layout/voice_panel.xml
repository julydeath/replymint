<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/overlay_shadow_pad">

    <LinearLayout
        android:id="@+id/voice_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:elevation="16dp"
        android:minWidth="264dp"
        android:orientation="vertical"
        android:outlineProvider="background"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_micdot">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/cd_mic"
                    android:src="@drawable/ic_mic"
                    android:tint="@color/mint" />
            </FrameLayout>

            <TextView
                android:id="@+id/voice_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/inter_semibold"
                android:text="@string/voice_listening"
                android:textColor="@color/mint"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Live waveform: bars scroll left as speech comes in, driven by the mic RMS. -->
        <com.replymint.bubble.WaveformView
            android:id="@+id/voice_wave"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/voice_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:maxLines="4"
            android:minLines="2"
            android:text="@string/voice_hint"
            android:textColor="@color/glass_text_dim"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/voice_stop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_cta"
            android:clickable="true"
            android:focusable="false"
            android:fontFamily="@font/inter_bold"
            android:gravity="center"
            android:minHeight="@dimen/menu_row_height"
            android:text="@string/voice_stop"
            android:textColor="@color/on_mint"
            android:textSize="15sp" />
    </LinearLayout>
</FrameLayout>
