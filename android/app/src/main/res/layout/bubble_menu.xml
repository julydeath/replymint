<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="@dimen/overlay_shadow_pad">

    <LinearLayout
        android:id="@+id/menu_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:elevation="16dp"
        android:minWidth="@dimen/menu_min_width"
        android:orientation="vertical"
        android:outlineProvider="background"
        android:padding="6dp">

        <LinearLayout android:id="@+id/action_auto" style="@style/GlassMenuRow">
            <ImageView style="@style/GlassMenuIcon"
                android:contentDescription="@string/action_auto"
                android:src="@drawable/ic_auto_reply" />
            <TextView style="@style/GlassMenuLabel" android:text="@string/action_auto" />
        </LinearLayout>

        <LinearLayout android:id="@+id/action_voice" style="@style/GlassMenuRow">
            <ImageView style="@style/GlassMenuIcon"
                android:contentDescription="@string/action_voice"
                android:src="@drawable/ic_mic" />
            <TextView style="@style/GlassMenuLabel" android:text="@string/action_voice" />
        </LinearLayout>

        <LinearLayout android:id="@+id/action_fix" style="@style/GlassMenuRow">
            <ImageView style="@style/GlassMenuIcon"
                android:contentDescription="@string/action_fix"
                android:src="@drawable/ic_fix" />
            <TextView style="@style/GlassMenuLabel" android:text="@string/action_fix" />
        </LinearLayout>

        <!-- Undo and its divider are GONE unless a draft is undoable in the current app, so the
             menu is a clean three rows in the common case. Height is therefore variable, which is
             why positionPanel() measures rather than assuming. -->
        <View
            android:id="@+id/undo_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="10dp"
            android:layout_marginVertical="4dp"
            android:background="@color/glass_stroke"
            android:visibility="gone" />

        <LinearLayout android:id="@+id/action_undo" style="@style/GlassMenuRow"
            android:visibility="gone">
            <ImageView style="@style/GlassMenuIcon"
                android:contentDescription="@string/action_undo"
                android:src="@drawable/ic_undo" />
            <TextView style="@style/GlassMenuLabel" android:text="@string/action_undo" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
