<?xml version="1.0" encoding="utf-8"?>
<!-- The apps the bubble appears in — mirrors TARGET_APPS in ReplyMintAccessibilityService.
     WA Business is covered by the WhatsApp tile; full-color brand marks, labels for recognition. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_app_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="13dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_whatsapp"
            android:src="@drawable/ic_app_whatsapp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_whatsapp"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_app_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="13dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_instagram"
            android:src="@drawable/ic_app_instagram" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_instagram"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_app_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="13dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_gmail"
            android:src="@drawable/ic_app_gmail" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_gmail"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/bg_app_tile"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="13dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/app_linkedin"
            android:src="@drawable/ic_app_linkedin" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_linkedin"
            android:textColor="@color/text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>
</LinearLayout>
